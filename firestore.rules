rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo usuarios con sesión iniciada (login) pueden leer/escribir.
    // Esto protege los datos personales de los clientes.
    match /ordenes/{doc} {
      allow read, write: if request.auth != null;
    }
    match /clientes/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
